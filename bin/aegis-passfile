#!/usr/bin/env bash
# Write stdin to a mode-0600 file under $XDG_RUNTIME_DIR and print the path.
# Used so Omarchy never puts a passphrase on argv, in env, or in the process title.
set -euo pipefail

if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR}" ]; then
  echo "XDG_RUNTIME_DIR is required" >&2
  exit 1
fi
runtime="${XDG_RUNTIME_DIR}/aegis-omarchy"
mkdir -p "$runtime"
chmod 700 "$runtime"
umask 077
file="$(mktemp "$runtime/pass.XXXXXX")"
chmod 600 "$file"
cat > "$file"
printf '%s\n' "$file"
