#!/usr/bin/env bash
# Lock the Aegis vault when Omarchy locks, suspends, or this process dies
# (logout / shell exit). Prints LOCK on stdout so the plugin can refresh UI.
set -u

AEGIS="${1:-aegis}"
OMARCHY_PATH="${2:-${OMARCHY_PATH:-/usr/share/omarchy}}"
PATH="${OMARCHY_PATH}/bin:${HOME}/.cargo/bin:${HOME}/.local/bin:${PATH}"

last_lock=0

lock_vault() {
  local now
  now=$(date +%s)
  if (( now - last_lock < 1 )); then
    return 0
  fi
  last_lock=$now
  env -u AEGIS_KDF "$AEGIS" lock >/dev/null 2>&1 || true
  printf 'LOCK\n'
}

# Logout and omarchy-restart-shell send TERM via pdeathsig.
trap 'lock_vault; exit 0' TERM INT HUP

watch_session_lock() {
  local locked=0
  if ! command -v omarchy-hyprland-session-locked >/dev/null 2>&1; then
    return 0
  fi
  while true; do
    if omarchy-hyprland-session-locked; then
      if (( locked == 0 )); then
        lock_vault
        locked=1
      fi
      sleep 1
    else
      locked=0
      sleep 0.4
    fi
  done
}

watch_logind() {
  local line
  if command -v gdbus >/dev/null 2>&1; then
    gdbus monitor --system --dest org.freedesktop.login1 2>/dev/null | while IFS= read -r line; do
      case "$line" in
        *PrepareForSleep*true*) lock_vault ;;
        *PrepareForShutdown*true*) lock_vault ;;
        *LockedHint*true*) lock_vault ;;
        *Session::Lock*) lock_vault ;;
      esac
    done
    return 0
  fi
  if command -v dbus-monitor >/dev/null 2>&1; then
    dbus-monitor --system \
      "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
      "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForShutdown'" \
      "type='signal',interface='org.freedesktop.login1.Session',member='Lock'" \
      2>/dev/null | while IFS= read -r line; do
      case "$line" in
        *PrepareForSleep*|*PrepareForShutdown*|*member=Lock*)
          lock_vault
          ;;
      esac
    done
  fi
}

watch_session_lock &
watch_logind &
wait
