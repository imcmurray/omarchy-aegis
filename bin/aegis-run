#!/usr/bin/python3
"""Descriptor-bound Aegis CLI runner for omarchy-aegis.

Walks owner-checked no-follow directory descriptors from `/`. Verifies the
CLI by SHA-256 of an O_NOFOLLOW fd against `cli.sha256`. Creates passphrase
files in a held 0700 runtime directory and passes them to the child as
`/proc/self/fd/N`. Runs the CLI in a new process group with a deadline,
output cap, TERM then KILL, and reaps. The session watcher uses absolute
system helpers and only prints `LOCK`.
"""

from __future__ import annotations

import ctypes
import hashlib
import json
import os
import re
import secrets
import select
import signal
import stat
import subprocess
import sys
import threading
import time

PLUGIN_ID = "ianm.aegis"
RUNTIME_NAME = "aegis-omarchy"
DIGEST_NAME = "cli.sha256"
MAX_DIGEST_FILE = 4096
MAX_CLI_BYTES = 64 * 1024 * 1024
MAX_HEADER = 2 * 1024 * 1024
DEFAULT_TIMEOUT_MS = 15000
DEFAULT_MAX_BYTES = 1024 * 1024
LOCK_TIMEOUT_MS = 10000
LINE_CAP = 8192
ROLE_FLAGS = {
    "pass": "--passphrase-file",
    "backup": "--backup-passphrase-file",
    "live": "--new-passphrase-file",
}
WAYLAND_RE = re.compile(r"^[A-Za-z0-9._-]+$")
USER_RE = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._-]*$")
HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
OPEN_DIR_NOFOLLOW = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
OPEN_READ_NOFOLLOW = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
OPEN_READ_INHERIT = os.O_RDONLY | os.O_NOFOLLOW
PR_SET_PDEATHSIG = 1
PR_SET_CHILD_SUBREAPER = 36
class Reject(Exception):
    def __init__(self, msg: str, code: int = 1) -> None:
        super().__init__(msg)
        self.code = code


def fail(msg: str, code: int = 1) -> None:
    raise Reject(msg, code)


def check_name(name: str) -> None:
    if not name or name in (".", "..") or "/" in name or "\0" in name:
        fail("invalid file name")


def require_abs(path: str, name: str) -> str:
    if not path or "\0" in path:
        fail(f"{name} is unset")
    if not path.startswith("/") or any(
        part in ("", ".", "..") for part in path.split("/")[1:]
    ):
        fail(f"{name} must be a canonical absolute path")
    return path


def check_dir(fd: int, path: str, *, ancestor: bool) -> None:
    st = os.fstat(fd)
    uid = os.getuid()
    owners = {0, uid} if ancestor else {uid}
    sticky_root = ancestor and st.st_uid == 0 and bool(st.st_mode & stat.S_ISVTX)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid not in owners:
        fail(f"refusing {path}: not a user-owned directory")
    if st.st_mode & 0o022 and not sticky_root:
        fail(f"refusing {path}: directory is group or world writable")


def split_rel(rel: str) -> list[str]:
    names = rel.split("/")
    if not names or any(name in ("", ".", "..") for name in names):
        fail("invalid path")
    for name in names:
        check_name(name)
    return names


def open_child_dir(parent_fd: int, name: str, path: str, *, ancestor: bool) -> int:
    try:
        child = os.open(name, OPEN_DIR_NOFOLLOW, dir_fd=parent_fd)
    except OSError as e:
        try:
            mode = os.lstat(name, dir_fd=parent_fd).st_mode
        except OSError:
            fail(f"{path}: {e}")
        if stat.S_ISLNK(mode):
            fail(f"refusing {path}: is a symlink")
        fail(f"{path}: {e}")
    try:
        check_dir(child, path, ancestor=ancestor)
        return child
    except BaseException:
        os.close(child)
        raise


def walk_from_root(
    components: list[str], *, ancestor_until: int, create_from: int
) -> int:
    try:
        fd = os.open("/", OPEN_DIR_NOFOLLOW)
    except OSError as e:
        fail(f"/: {e}")
    try:
        check_dir(fd, "/", ancestor=True)
        walked = ""
        for i, name in enumerate(components):
            walked = f"{walked}/{name}"
            if i >= create_from:
                try:
                    os.mkdir(name, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                except OSError as e:
                    fail(f"{walked}: {e}")
            child = open_child_dir(fd, name, walked, ancestor=i < ancestor_until)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def home_names() -> list[str]:
    home = require_abs(os.environ.get("HOME", ""), "HOME")
    return split_rel(home[1:])


def ancestor_until_for(names: list[str]) -> int:
    home = home_names()
    if len(names) >= len(home) and names[: len(home)] == home:
        return max(len(home) - 1, 0)
    return len(names)


def open_regular(path: str, *, allow_root: bool) -> int:
    path = require_abs(path, "path")
    names = split_rel(path[1:])
    parent = names[:-1]
    base = names[-1]
    dir_fd = walk_from_root(
        parent,
        ancestor_until=ancestor_until_for(parent),
        create_from=len(parent),
    )
    try:
        try:
            fd = os.open(base, OPEN_READ_INHERIT, dir_fd=dir_fd)
        except OSError as e:
            fail(f"{path}: {e}")
        st = os.fstat(fd)
        uid = os.getuid()
        owners = {0, uid} if allow_root else {uid}
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in owners:
            os.close(fd)
            fail(f"refusing {path}: not an allowed regular file")
        if st.st_size > MAX_CLI_BYTES:
            os.close(fd)
            fail(f"refusing {path}: too large")
        if st.st_mode & 0o111 == 0:
            os.close(fd)
            fail(f"refusing {path}: not executable")
        return fd
    finally:
        os.close(dir_fd)


def hash_fd(fd: int) -> str:
    os.lseek(fd, 0, os.SEEK_SET)
    h = hashlib.sha256()
    while True:
        chunk = os.read(fd, 1024 * 1024)
        if not chunk:
            break
        h.update(chunk)
    os.lseek(fd, 0, os.SEEK_SET)
    return h.hexdigest()


def plugin_root() -> str:
    here = os.path.dirname(os.path.abspath(__file__))
    root = os.path.dirname(here)
    return require_abs(root, "plugin directory")


def load_digests() -> set[str]:
    root = plugin_root()
    names = split_rel(root[1:])
    dir_fd = walk_from_root(
        names,
        ancestor_until=ancestor_until_for(names),
        create_from=len(names),
    )
    try:
        try:
            fd = os.open(DIGEST_NAME, OPEN_READ_NOFOLLOW, dir_fd=dir_fd)
        except OSError as e:
            fail(f"{DIGEST_NAME}: {e}")
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
                fail(f"refusing {DIGEST_NAME}: not a user-owned regular file")
            if st.st_size > MAX_DIGEST_FILE:
                fail(f"{DIGEST_NAME} is too large")
            raw = os.read(fd, st.st_size).decode("ascii", "strict")
        finally:
            os.close(fd)
    finally:
        os.close(dir_fd)
    out: set[str] = set()
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        digest = line.split()[0].lower()
        if not HEX64_RE.fullmatch(digest):
            fail(f"invalid digest in {DIGEST_NAME}")
        out.add(digest)
    if not out:
        fail(f"{DIGEST_NAME} has no digests")
    return out


def cli_candidates() -> list[tuple[str, bool]]:
    home = require_abs(os.environ.get("HOME", ""), "HOME")
    return [
        ("/usr/bin/aegis", True),
        ("/usr/local/bin/aegis", True),
        (f"{home}/.local/bin/aegis", False),
    ]


def resolve_cli(digests: set[str]) -> tuple[str, int, str]:
    last = "aegis CLI not found"
    for path, allow_root in cli_candidates():
        try:
            fd = open_regular(path, allow_root=allow_root)
        except Reject as e:
            last = str(e)
            continue
        except OSError as e:
            last = f"{path}: {e}"
            continue
        digest = hash_fd(fd)
        if digest in digests:
            return path, fd, digest
        os.close(fd)
        last = f"{path}: digest mismatch"
    fail(
        "no attested aegis CLI. Install the linux-x86_64 GitHub Release "
        f"artifact whose SHA-256 is in {DIGEST_NAME}. Last: {last}"
    )
    raise AssertionError("unreachable")


def set_pdeathsig(sig: int = signal.SIGTERM) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_PDEATHSIG, sig, 0, 0, 0) != 0:
        err = ctypes.get_errno()
        fail(f"prctl PR_SET_PDEATHSIG: {os.strerror(err)}")
    if os.getppid() == 1:
        raise SystemExit(0)


def become_subreaper() -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        err = ctypes.get_errno()
        fail(f"prctl PR_SET_CHILD_SUBREAPER: {os.strerror(err)}")


def child_setup() -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0)
    if os.getppid() == 1:
        os._exit(0)


def closed_env() -> dict[str, str]:
    home = require_abs(os.environ.get("HOME", ""), "HOME")
    xdg = require_abs(os.environ.get("XDG_RUNTIME_DIR", ""), "XDG_RUNTIME_DIR")
    env = {
        "PATH": "/usr/bin:/bin",
        "LC_ALL": "C",
        "HOME": home,
        "XDG_RUNTIME_DIR": xdg,
        "XDG_SESSION_TYPE": "wayland",
    }
    wayland = os.environ.get("WAYLAND_DISPLAY", "")
    if wayland and WAYLAND_RE.fullmatch(wayland):
        env["WAYLAND_DISPLAY"] = wayland
    user = os.environ.get("USER", "")
    if user and USER_RE.fullmatch(user):
        env["USER"] = user
    return env


def open_runtime_dir() -> int:
    xdg = require_abs(os.environ.get("XDG_RUNTIME_DIR", ""), "XDG_RUNTIME_DIR")
    names = split_rel(xdg[1:])
    if not names:
        fail("XDG_RUNTIME_DIR must not be /")
    parent, last = names[:-1], names[-1]
    if parent:
        root_fd = walk_from_root(
            parent, ancestor_until=len(parent), create_from=len(parent)
        )
    else:
        root_fd = os.open("/", OPEN_DIR_NOFOLLOW)
        check_dir(root_fd, "/", ancestor=True)
    try:
        xdg_fd = open_child_dir(root_fd, last, xdg, ancestor=False)
    finally:
        os.close(root_fd)
    try:
        try:
            os.mkdir(RUNTIME_NAME, 0o700, dir_fd=xdg_fd)
        except FileExistsError:
            pass
        except OSError as e:
            fail(f"{xdg}/{RUNTIME_NAME}: {e}")
        fd = open_child_dir(
            xdg_fd, RUNTIME_NAME, f"{xdg}/{RUNTIME_NAME}", ancestor=False
        )
    finally:
        os.close(xdg_fd)
    os.fchmod(fd, 0o700)
    return fd


def make_passfile(dir_fd: int, secret: str) -> tuple[str, int]:
    data = secret.encode("utf-8")
    if not data.endswith(b"\n"):
        data += b"\n"
    name = f"p.{secrets.token_hex(16)}"
    wfd = os.open(
        name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=dir_fd,
    )
    try:
        os.write(wfd, data)
        os.fsync(wfd)
        os.fchmod(wfd, 0o600)
    finally:
        os.close(wfd)
    rfd = os.open(name, OPEN_READ_INHERIT, dir_fd=dir_fd)
    st = os.fstat(rfd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        os.close(rfd)
        fail("passfile is not a user-owned regular file")
    if st.st_mode & 0o777 != 0o600:
        os.close(rfd)
        fail("passfile must be mode 0600")
    return name, rfd


def unlink_passfile(dir_fd: int, name: str) -> None:
    check_name(name)
    try:
        os.unlink(name, dir_fd=dir_fd)
    except FileNotFoundError:
        return
    os.fsync(dir_fd)


def _signal_group(pgid: int, sig: int) -> bool:
    try:
        os.killpg(pgid, sig)
        return True
    except ProcessLookupError:
        return False


def _reap_group(pgid: int) -> tuple[bool, int | None]:
    """Reap every available child in pgid. Returns (group empty, leader wait status)."""
    leader_status: int | None = None
    while True:
        try:
            waited, status = os.waitpid(-pgid, os.WNOHANG)
        except ChildProcessError:
            return True, leader_status
        if waited == 0:
            return False, leader_status
        if waited == pgid:
            leader_status = status


def _apply_wait_status(proc: subprocess.Popen, status: int) -> None:
    if os.WIFEXITED(status):
        proc.returncode = os.WEXITSTATUS(status)
    elif os.WIFSIGNALED(status):
        proc.returncode = -os.WTERMSIG(status)
    else:
        proc.returncode = 1


def kill_group(pid: int) -> int | None:
    """TERM the group, then KILL at the grace deadline even if the leader already died.

    Reaps every child in the group (subreaper descendants included). Returns the
    leader's wait status if this function reaped it, else None.
    """
    _signal_group(pid, signal.SIGTERM)
    deadline = time.monotonic() + 0.5
    leader_status: int | None = None
    while time.monotonic() < deadline:
        empty, status = _reap_group(pid)
        if status is not None:
            leader_status = status
        if empty:
            return leader_status
        time.sleep(0.02)
    _signal_group(pid, signal.SIGKILL)
    kill_deadline = time.monotonic() + 0.5
    while time.monotonic() < kill_deadline:
        empty, status = _reap_group(pid)
        if status is not None:
            leader_status = status
        if empty:
            return leader_status
        try:
            os.killpg(pid, 0)
        except ProcessLookupError:
            empty, status = _reap_group(pid)
            if status is not None:
                leader_status = status
            return leader_status
        time.sleep(0.02)
    empty, status = _reap_group(pid)
    if status is not None:
        leader_status = status
    return leader_status


def run_group(
    argv: list[str],
    *,
    executable: str,
    env: dict[str, str],
    stdin_data: bytes | None,
    timeout_ms: int,
    max_bytes: int,
    pass_fds: list[int],
) -> tuple[int, bytes, bytes]:
    become_subreaper()
    try:
        proc = subprocess.Popen(
            argv,
            executable=executable,
            stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            start_new_session=True,
            close_fds=True,
            pass_fds=tuple(pass_fds),
            preexec_fn=child_setup,
        )
    except BaseException:
        for fd in pass_fds:
            try:
                os.close(fd)
            except OSError:
                pass
        raise
    for fd in pass_fds:
        try:
            os.close(fd)
        except OSError:
            pass
    assert proc.stdout is not None and proc.stderr is not None
    stdin_fd: int | None = None
    stdin_view: memoryview | None = None
    stdin_off = 0
    if stdin_data is not None and proc.stdin is not None:
        stdin_fd = proc.stdin.fileno()
        os.set_blocking(stdin_fd, False)
        stdin_view = memoryview(stdin_data)
        if not stdin_data:
            try:
                proc.stdin.close()
            except BrokenPipeError:
                pass
            stdin_fd = None
    for pipe in (proc.stdout, proc.stderr):
        os.set_blocking(pipe.fileno(), False)

    def close_stdin() -> None:
        nonlocal stdin_fd
        if proc.stdin is not None:
            try:
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass
        stdin_fd = None

    out = bytearray()
    err = bytearray()
    streams: list[int] = [proc.stdout.fileno(), proc.stderr.fileno()]
    stdout_fd = proc.stdout.fileno()
    deadline = time.monotonic() + (timeout_ms / 1000.0)
    timed_out = False
    exceeded = False
    while streams or stdin_fd is not None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break
        writers = [stdin_fd] if stdin_fd is not None else []
        ready_r, ready_w, _ = select.select(streams, writers, [], remaining)
        if not ready_r and not ready_w:
            timed_out = True
            break
        if stdin_fd is not None and stdin_fd in ready_w and stdin_view is not None:
            chunk = stdin_view[stdin_off : stdin_off + 4096]
            try:
                n = os.write(stdin_fd, chunk)
            except BlockingIOError:
                n = 0
            except BrokenPipeError:
                close_stdin()
                n = 0
            else:
                stdin_off += n
                if stdin_off >= len(stdin_data or b""):
                    close_stdin()
        for fd in ready_r:
            try:
                chunk = os.read(fd, 4096)
            except BlockingIOError:
                continue
            if not chunk:
                streams.remove(fd)
                continue
            target = out if fd == stdout_fd else err
            target.extend(chunk)
            if len(out) > max_bytes or len(err) > max_bytes:
                exceeded = True
                streams = []
                close_stdin()
                break
        if proc.poll() is not None and not streams:
            close_stdin()
            break
    if timed_out or exceeded:
        close_stdin()
        reaped = kill_group(proc.pid)
        if reaped is not None:
            _apply_wait_status(proc, reaped)
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        reaped = kill_group(proc.pid)
        if reaped is not None:
            _apply_wait_status(proc, reaped)
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            fail("aegis process group did not exit after SIGKILL", 124)
    if timed_out:
        fail(f"aegis timed out after {timeout_ms}ms", 124)
    if exceeded:
        fail(f"aegis output exceeded {max_bytes} bytes", 125)
    code = proc.returncode if proc.returncode is not None else 1
    return code, bytes(out), bytes(err)


def read_header() -> dict:
    buf = bytearray()
    while True:
        ch = os.read(0, 1)
        if not ch or ch == b"\n":
            break
        buf.extend(ch)
        if len(buf) > MAX_HEADER:
            fail("stdin header too large")
    if not buf:
        return {}
    try:
        obj = json.loads(buf.decode("utf-8"))
    except (ValueError, UnicodeError) as e:
        fail(f"stdin header: {e}")
    if not isinstance(obj, dict):
        fail("stdin header must be a JSON object")
    return obj


def parse_ms(raw: str | None, default: int) -> int:
    if raw is None:
        return default
    try:
        n = int(raw)
    except ValueError:
        fail("timeout must be an integer")
    if n < 100 or n > 300000:
        fail("timeout out of range")
    return n


def parse_max_bytes(raw: str | None, default: int) -> int:
    if raw is None:
        return default
    try:
        n = int(raw)
    except ValueError:
        fail("max-bytes must be an integer")
    if n < 64 or n > 8 * 1024 * 1024:
        fail("max-bytes out of range")
    return n


def cmd_resolve() -> None:
    path, fd, digest = resolve_cli(load_digests())
    os.close(fd)
    print(path)
    print(digest, file=sys.stderr)


def cmd_run(argv: list[str]) -> None:
    timeout_ms = DEFAULT_TIMEOUT_MS
    max_bytes = DEFAULT_MAX_BYTES
    roles: list[str] = []
    rest: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            rest = argv[i + 1 :]
            break
        if arg == "--timeout-ms" and i + 1 < len(argv):
            timeout_ms = parse_ms(argv[i + 1], timeout_ms)
            i += 2
            continue
        if arg == "--max-bytes" and i + 1 < len(argv):
            max_bytes = parse_max_bytes(argv[i + 1], max_bytes)
            i += 2
            continue
        if arg == "--role" and i + 1 < len(argv):
            role = argv[i + 1]
            if role not in ROLE_FLAGS:
                fail(f"unknown role {role}")
            roles.append(role)
            i += 2
            continue
        fail(f"unknown run argument {arg}")
    set_pdeathsig()
    header = read_header()
    rpc = header.get("rpc")
    stdin_data = None
    if rpc is not None:
        if not isinstance(rpc, str):
            fail("rpc must be a string")
        stdin_data = rpc.encode("utf-8")
    digests = load_digests()
    path, cli_fd, _digest = resolve_cli(digests)
    env = closed_env()
    dir_fd = None
    pass_names: list[str] = []
    pass_fds: list[int] = [cli_fd]
    child_args = ["aegis"]
    try:
        if roles:
            dir_fd = open_runtime_dir()
            for role in roles:
                secret = header.get(role)
                if not isinstance(secret, str):
                    fail(f"missing passphrase for {role}")
                name, rfd = make_passfile(dir_fd, secret)
                pass_names.append(name)
                pass_fds.append(rfd)
                child_args.extend([ROLE_FLAGS[role], f"/proc/self/fd/{rfd}"])
        child_args.extend(rest)
        executable = f"/proc/self/fd/{cli_fd}"
        owned = pass_fds
        pass_fds = []
        code, out, err = run_group(
            child_args,
            executable=executable,
            env=env,
            stdin_data=stdin_data,
            timeout_ms=timeout_ms,
            max_bytes=max_bytes,
            pass_fds=owned,
        )
        if out:
            sys.stdout.buffer.write(out)
            sys.stdout.buffer.flush()
        if err:
            sys.stderr.buffer.write(err)
            sys.stderr.buffer.flush()
        raise SystemExit(code)
    finally:
        for fd in pass_fds:
            try:
                os.close(fd)
            except OSError:
                pass
        if dir_fd is not None:
            for name in pass_names:
                unlink_passfile(dir_fd, name)
            os.close(dir_fd)


def open_sys_helper(path: str) -> int:
    path = require_abs(path, "helper")
    names = split_rel(path[1:])
    parent, base = names[:-1], names[-1]
    dir_fd = walk_from_root(
        parent, ancestor_until=len(parent), create_from=len(parent)
    )
    try:
        try:
            fd = os.open(base, OPEN_READ_INHERIT, dir_fd=dir_fd)
        except OSError as e:
            fail(f"{path}: {e}")
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0:
            os.close(fd)
            fail(f"refusing {path}: not a root-owned regular file")
        if st.st_mode & 0o111 == 0:
            os.close(fd)
            fail(f"refusing {path}: not executable")
        return fd
    finally:
        os.close(dir_fd)


def iter_capped_lines(fd: int, cap: int = LINE_CAP):
    buf = bytearray()
    overflow = False
    while True:
        chunk = os.read(fd, 1024)
        if not chunk:
            if buf and not overflow:
                yield bytes(buf)
            return
        for b in chunk:
            if b == 10:
                if buf and not overflow:
                    yield bytes(buf)
                buf.clear()
                overflow = False
            elif overflow:
                continue
            elif len(buf) >= cap:
                overflow = True
                buf.clear()
            else:
                buf.append(b)


def lock_event(cli_fd: int, env: dict[str, str], timeout_ms: int, last: list[float]) -> None:
    now = time.monotonic()
    if now - last[0] < 1.0:
        return
    last[0] = now
    dup = os.dup(cli_fd)
    try:
        run_group(
            ["aegis", "--json", "lock"],
            executable=f"/proc/self/fd/{dup}",
            env=env,
            stdin_data=None,
            timeout_ms=timeout_ms,
            max_bytes=4096,
            pass_fds=[dup],
        )
    except Reject:
        pass
    sys.stdout.write("LOCK\n")
    sys.stdout.flush()


def cmd_watch(argv: list[str]) -> None:
    timeout_ms = LOCK_TIMEOUT_MS
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--lock-timeout-ms" and i + 1 < len(argv):
            timeout_ms = parse_ms(argv[i + 1], timeout_ms)
            i += 2
            continue
        fail(f"unknown watch argument {arg}")
    set_pdeathsig()
    try:
        os.setpgrp()
    except OSError:
        pass
    env = closed_env()
    _path, cli_fd, _digest = resolve_cli(load_digests())
    last = [0.0]
    children: list[subprocess.Popen] = []

    def shutdown(*_args: object) -> None:
        lock_event(cli_fd, env, timeout_ms, last)
        for child in children:
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except (ProcessLookupError, PermissionError, OSError):
                    try:
                        child.terminate()
                    except OSError:
                        pass
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGHUP, shutdown)

    try:
        locked_fd = open_sys_helper("/usr/bin/omarchy-hyprland-session-locked")
    except Reject:
        locked_fd = -1

    def poll_session_lock() -> None:
        if locked_fd < 0:
            return
        locked = False
        while True:
            proc = subprocess.Popen(
                ["omarchy-hyprland-session-locked"],
                executable=f"/proc/self/fd/{locked_fd}",
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=env,
                start_new_session=True,
                close_fds=True,
                pass_fds=(locked_fd,),
            )
            try:
                code = proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                kill_group(proc.pid)
                proc.wait(timeout=2)
                code = 1
            now_locked = code == 0
            if now_locked and not locked:
                lock_event(cli_fd, env, timeout_ms, last)
            locked = now_locked
            time.sleep(1.0 if now_locked else 0.4)

    def watch_logind() -> None:
        helper = None
        args: list[str]
        try:
            helper = open_sys_helper("/usr/bin/gdbus")
            args = [
                "gdbus",
                "monitor",
                "--system",
                "--dest",
                "org.freedesktop.login1",
            ]
            executable = f"/proc/self/fd/{helper}"
            pass_fds = (helper,)
        except Reject:
            helper = open_sys_helper("/usr/bin/dbus-monitor")
            args = [
                "dbus-monitor",
                "--system",
                "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'",
                "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForShutdown'",
                "type='signal',interface='org.freedesktop.login1.Session',member='Lock'",
            ]
            executable = f"/proc/self/fd/{helper}"
            pass_fds = (helper,)
        proc = subprocess.Popen(
            args,
            executable=executable,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=env,
            start_new_session=True,
            close_fds=True,
            pass_fds=pass_fds,
        )
        children.append(proc)
        os.close(helper)
        assert proc.stdout is not None
        for line in iter_capped_lines(proc.stdout.fileno()):
            text = line.decode("utf-8", "replace")
            low = text.lower()
            if (
                "PrepareForSleep" in text
                or "PrepareForShutdown" in text
                or ("LockedHint" in text and "true" in low)
                or "Session::Lock" in text
                or "member=Lock" in text
            ):
                lock_event(cli_fd, env, timeout_ms, last)

    threads = [
        threading.Thread(target=poll_session_lock, daemon=True),
        threading.Thread(target=watch_logind, daemon=True),
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join()


def usage() -> None:
    fail(
        "usage: aegis-run resolve\n"
        "       aegis-run run [--timeout-ms N] [--max-bytes N] [--role pass|backup|live] -- [aegis args]\n"
        "       aegis-run watch [--lock-timeout-ms N]",
        2,
    )


def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        usage()
    cmd = argv[1]
    rest = argv[2:]
    try:
        if cmd == "resolve":
            cmd_resolve()
        elif cmd == "run":
            cmd_run(rest)
        elif cmd == "watch":
            cmd_watch(rest)
        else:
            usage()
    except Reject as e:
        print(str(e), file=sys.stderr)
        raise SystemExit(e.code)


if __name__ == "__main__":
    main(sys.argv)
